#---------------------------------------------------------------------------
#  n-Dodecane high temperature skeletal model based on FFCM-2
#---------------------------------------------------------------------------

units(length='cm', time='s', quantity='mol', act_energy='cal/mol')

ideal_gas(name='gas',
          elements="H O Ar N C",
          species="""H        H2       O        O2       OH       H2O
                     HO2      H2O2     AR       N2       CH2      CH2(S)
                     CH3      CH4      CO       CO2      HCO      CH2O
                     CH3O     C2H      C2H2     C2H3     C2H4     C2H5
                     C2H6     HCCO     CH2CO    CH2CHO   H2CC     IC3H7
                     C3H6     C3H5     AC3H4    PC3H4    C2H3CHO  C4H2
                     IC4H3    C4H4     IC4H5    C4H6     C4H7     C4H81
                     NC12H26""",
          reactions='all',
          transport='Mix',
          initial_state=state(temperature=300.0, pressure=OneAtm))

